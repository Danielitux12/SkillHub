@model ProfileViewModel
@{
    ViewData["Title"] = "Mi Perfil";
    var initials = string.Join("", Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
}

<div class="mb-4">
    <a asp-controller="Workshops" asp-action="Index" class="btn btn-outline-secondary btn-sm shadow-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver a Talleres
    </a>
</div>

<div class="row g-4">
    <!-- Columna Izquierda: Tarjeta de Resumen / Avatar -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 text-center p-4 mb-4">
            <div class="card-body p-0">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center text-white fw-bold shadow"
                     style="width: 88px; height: 88px; border-radius: 24px; font-size: 2rem; background: var(--gradient-primary);">
                    @(string.IsNullOrEmpty(initials) ? "SH" : initials)
                </div>

                <h4 class="fw-bold text-dark mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-3">@Model.Email</p>

                <div class="mb-3">
                    @if (Model.IsEmployee)
                    {
                        <span class="badge bg-warning text-dark px-3 py-2 fs-6 shadow-sm">
                            <i class="bi bi-shield-lock-fill me-1"></i> @Model.Role
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-primary text-white px-3 py-2 fs-6 shadow-sm">
                            <i class="bi bi-person-fill me-1"></i> @Model.Role
                        </span>
                    }
                </div>

                <hr class="my-4">

                <!-- Estadísticas según Rol -->
                <div class="row g-2 mb-4">
                    @if (Model.IsEmployee)
                    {
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="text-primary fs-3 fw-bold">@Model.TotalWorkshopsTaughtCount</div>
                                <div class="text-muted small text-uppercase fw-semibold">Talleres a Cargo</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="text-success fs-3 fw-bold">@Model.ActiveEnrollmentsCount</div>
                                <div class="text-muted small text-uppercase fw-semibold">Inscripciones Activas</div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Enlaces rápidos -->
                <div class="d-grid gap-2">
                    <a asp-action="ChangePassword" class="btn btn-outline-primary btn-sm py-2">
                        <i class="bi bi-key-fill me-1"></i> Cambiar Contraseña
                    </a>
                    @if (Model.IsEmployee)
                    {
                        <a asp-controller="Workshops" asp-action="Create" class="btn btn-primary btn-sm py-2">
                            <i class="bi bi-plus-circle me-1"></i> Crear Nuevo Taller
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Enrollments" asp-action="Mine" class="btn btn-outline-primary btn-sm py-2">
                            <i class="bi bi-bookmark-check-fill me-1"></i> Ver Mis Inscripciones
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Columna Derecha: Formulario de Edición de Datos -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 overflow-hidden">
            <div class="card-header py-3 px-4 border-bottom d-flex align-items-center gap-2">
                <i class="bi bi-person-gear text-primary fs-5"></i>
                <h5 class="fw-bold mb-0 text-dark">Información de Perfil</h5>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3" role="alert"></div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <label asp-for="FullName" class="form-label small fw-bold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person text-muted"></i></span>
                                <input asp-for="FullName" class="form-control" placeholder="Tu nombre completo" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-bold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope text-muted"></i></span>
                                <input asp-for="Email" class="form-control" readonly disabled />
                            </div>
                            <div class="form-text small text-muted">El correo es tu identificador único de cuenta.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label small fw-bold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone text-muted"></i></span>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="+57 300 123 4567" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        @if (Model.IsEmployee)
                        {
                            <div class="col-md-12">
                                <label asp-for="Specialty" class="form-label small fw-bold text-secondary"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-award text-muted"></i></span>
                                    <input asp-for="Specialty" class="form-control" placeholder="Ej. Fotografía Digital, Gastronomía, Oratoria..." />
                                </div>
                                <span asp-validation-for="Specialty" class="text-danger small"></span>
                                <div class="form-text small text-muted">Especialidad técnica o profesional visible para los participantes.</div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
