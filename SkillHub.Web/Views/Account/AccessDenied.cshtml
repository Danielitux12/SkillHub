@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0 p-4">
            <div class="card-body">
                <i class="bi bi-shield-slash-fill text-danger display-1 mb-3"></i>
                <h2 class="card-title fw-bold text-danger">Acceso Denegado</h2>
                <p class="text-muted mt-3">
                    No dispones de los permisos suficientes para acceder a este recurso. Esta sección está reservada exclusivamente para personal autorizado.
                </p>
                <div class="mt-4">
                    <a asp-controller="Workshops" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-grid-fill me-1"></i> Ir al Catálogo de Talleres
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary ms-2">
                        <i class="bi bi-house-door me-1"></i> Ir al Inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
