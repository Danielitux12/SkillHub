@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center my-4">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-white py-4 border-0 text-center pb-2">
                <div class="feature-icon-circle feature-icon-indigo mx-auto mb-3 shadow-sm">
                    <i class="bi bi-box-arrow-in-right fs-3"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">Iniciar Sesión</h3>
                <p class="text-muted small">Accede a tu cuenta para gestionar tus talleres</p>
            </div>
            <div class="card-body px-4 pb-4">
                <form asp-action="Login" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-bold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                            <input asp-for="Email" class="form-control border-start-0" placeholder="ejemplo@correo.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-bold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                            <input asp-for="Password" class="form-control border-start-0" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary py-2 shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                        </button>
                    </div>
                </form>

                <div class="card bg-light border mt-4 p-3 rounded-3 small">
                    <div class="fw-bold text-dark mb-1 d-flex align-items-center gap-1">
                        <i class="bi bi-key-fill text-warning"></i>
                        <span>Acceso de Prueba (Staff):</span>
                    </div>
                    <div class="text-muted"><code>empleado@skillhub.com</code> / <code>Password123!</code></div>
                </div>

                <div class="text-center mt-4 small text-muted">
                    ¿No tienes una cuenta aún?
                    <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-primary text-decoration-none">Regístrate aquí</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
