@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="row justify-content-center my-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-4 border-0 text-center">
                <div class="d-inline-flex p-3 rounded-circle bg-primary bg-opacity-10 text-primary mb-2">
                    <i class="bi bi-shield-lock fs-1"></i>
                </div>
                <h3 class="fw-bold text-primary mt-1">Cambiar Contraseña</h3>
                <p class="text-muted small mb-0">Actualiza las credenciales de seguridad de tu cuenta con Identity</p>
            </div>
            <div class="card-body px-4 pb-4">
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="CurrentPassword" class="form-control" placeholder="••••••••" autofocus />
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input asp-for="NewPassword" class="form-control" placeholder="Mínimo 6 caracteres" />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Repite tu nueva contraseña" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-light border p-3 small mb-4">
                        <div class="fw-bold text-dark mb-1">
                            <i class="bi bi-info-circle text-info me-1"></i> Recomendaciones de seguridad:
                        </div>
                        <ul class="mb-0 ps-3 text-muted">
                            <li>La contraseña debe tener al menos 6 caracteres.</li>
                            <li>No compartas tus credenciales con terceros.</li>
                        </ul>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                            <i class="bi bi-check-circle-fill me-1"></i> Actualizar Contraseña
                        </button>
                        <a asp-controller="Workshops" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Volver al Catálogo
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
