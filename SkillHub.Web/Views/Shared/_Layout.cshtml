<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkillHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon-wrapper">
                        <i class="bi bi-mortarboard-fill fs-5"></i>
                    </div>
                    <span class="text-white">Skill<span class="text-warning">Hub</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Workshops" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active fw-bold" : "")"
                               asp-controller="Workshops" asp-action="Index">
                                <i class="bi bi-grid-fill me-1"></i> Catálogo de Talleres
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true && User.IsParticipant())
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Enrollments" && ViewContext.RouteData.Values["action"]?.ToString() == "Mine" ? "active fw-bold" : "")"
                                   asp-controller="Enrollments" asp-action="Mine">
                                    <i class="bi bi-bookmark-check-fill me-1"></i> Mis Inscripciones
                                </a>
                            </li>
                        }

                        @if (User.Identity?.IsAuthenticated == true && User.IsEmployee())
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle active fw-bold text-warning" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Panel Empleado
                                </a>
                                <ul class="dropdown-menu shadow" aria-labelledby="adminDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Workshops" asp-action="Create">
                                            <i class="bi bi-plus-circle-fill text-success me-2"></i> Crear Nuevo Taller
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Enrollments" asp-action="Import">
                                            <i class="bi bi-file-earmark-spreadsheet-fill text-primary me-2"></i> Importar Inscripciones (Excel)
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Reports" asp-action="TopWorkshops">
                                            <i class="bi bi-bar-chart-line-fill text-info me-2"></i> Reporte: Talleres con Mayor Demanda
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-2" href="#" id="userMenuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5"></i>
                                    <span>@User.Identity?.Name</span>
                                    @if (User.IsEmployee())
                                    {
                                        <span class="badge bg-warning text-dark">Staff / Instructor</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">Participante</span>
                                    }
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userMenuDropdown">
                                    <li>
                                        <h6 class="dropdown-header">
                                            <i class="bi bi-person-fill me-1"></i> Mi Cuenta
                                        </h6>
                                    </li>
                                    <li>
                                        <a class="dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "ChangePassword" ? "active" : "")"
                                           asp-controller="Account" asp-action="ChangePassword">
                                            <i class="bi bi-key-fill text-primary me-2"></i> Cambiar Contraseña
                                        </a>
                                    </li>
                                    @if (User.IsParticipant())
                                    {
                                        <li>
                                            <a class="dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Enrollments" && ViewContext.RouteData.Values["action"]?.ToString() == "Mine" ? "active" : "")"
                                               asp-controller="Enrollments" asp-action="Mine">
                                                <i class="bi bi-bookmark-check-fill text-success me-2"></i> Mis Inscripciones
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger d-flex align-items-center">
                                                <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm fw-bold text-dark" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus-fill me-1"></i> Registrarse
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        <partial name="_Alerts" />
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top py-3 mt-auto text-muted">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <div class="col-md-6 d-flex align-items-center">
                <span class="fw-semibold text-primary">SkillHub</span>
                <span class="ms-2">&copy; 2026 - Gestión de Talleres y Formación Presencial</span>
            </div>
            <div class="col-md-6 text-end small">
                <span class="text-secondary">Clean Architecture &bull; ASP.NET Core 10 MVC &bull; PostgreSQL &bull; QuestPDF</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
